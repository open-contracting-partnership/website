<div
    id="{{ block.id }}"
    class="youtube-shorts"
    data-block-spacing-top="{{ block.block_spacing.top }}"
    data-block-spacing-bottom="{{ block.block_spacing.bottom }}"
    data-block="youtube-shorts"
>
    {% if block.youtube_shorts is not empty %}
        <div class="youtube-shorts__container">
            <div class="youtube-shorts__grid" data-youtube-carousel>

                {% for short in block.youtube_shorts %}
                    <div class="youtube-shorts__item" data-youtube-carousel-item>
                        <div class="youtube-short" data-youtube-short>
                            {% if short.poster_image and short.poster_image.src %}
                                <img
                                    src="{{ short.poster_image.src }}"
                                    alt="{{ short.poster_image.alt|default('Video') }}"
                                    class="youtube-short__poster"
                                    loading="lazy"
                                >

                                {% if short.video_id %}
                                    <button
                                        class="youtube-short__play-btn"
                                        aria-label="Play video"
                                        data-video-id="{{ short.video_id }}"
                                        type="button"
                                        data-youtube-short-play-button
                                    >
                                        <svg class="youtube-short__play-icon" viewBox="0 0 24 24" fill="currentColor" width="48" height="48">
                                            <path d="M8 5v14l11-7z"/>
                                        </svg>
                                    </button>
                                {% endif %}

                            {% else %}
                                {# Fallback: load iframe directly if no poster image is provided #}
                                {% if short.video_id %}
                                    <iframe
                                        class="youtube-short__iframe"
                                        src="https://www.youtube.com/embed/{{ short.video_id }}?enablejsapi=1"
                                        title="YouTube Short"
                                        frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                                        allowfullscreen
                                        data-youtube-short-iframe
                                    ></iframe>
                                {% endif %}
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>

            <div div class="youtube-shorts__carousel-controls" data-youtube-carousel-controls>
                <button class="button--naked" rel="prev" aria-label="Previous video">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="24" cy="24" r="24" fill="white"/>
                        <path d="M24 6.04075e-06C19.2525 7.23472e-06 14.6117 1.40801 10.6645 4.04592C6.7174 6.68383 3.64127 10.4331 1.82527 14.8195C0.00927032 19.206 -0.465015 24.0324 0.462411 28.6884C1.38984 33.3444 3.6773 37.6208 7.03547 40.9766C10.3936 44.3324 14.6716 46.6168 19.3283 47.5409C23.9849 48.465 28.8111 47.9873 33.1962 46.1682C37.5813 44.3491 41.3284 41.2703 43.9635 37.3213C46.5986 33.3723 48.0034 28.7304 48 23.983C48 20.8321 47.3791 17.712 46.1728 14.8012C44.9664 11.8903 43.1983 9.24568 40.9695 7.01843C38.7407 4.79119 36.0948 3.02497 33.1831 1.82071C30.2714 0.616457 27.1509 -0.00223024 24 6.04075e-06ZM16.1021 34.4V29.7532L25.2936 24.2043L16.1021 18.8426V13.617L33.8723 24.2383L16.1021 34.4Z" fill="#323232"/>
                    </svg>
                </button>

                <button class="button--naked" rel="next" aria-label="Next video">
                    <svg width="48" height="48" viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <circle cx="24" cy="24" r="24" fill="white"/>
                        <path d="M24 6.04075e-06C19.2525 7.23472e-06 14.6117 1.40801 10.6645 4.04592C6.7174 6.68383 3.64127 10.4331 1.82527 14.8195C0.00927032 19.206 -0.465015 24.0324 0.462411 28.6884C1.38984 33.3444 3.6773 37.6208 7.03547 40.9766C10.3936 44.3324 14.6716 46.6168 19.3283 47.5409C23.9849 48.465 28.8111 47.9873 33.1962 46.1682C37.5813 44.3491 41.3284 41.2703 43.9635 37.3213C46.5986 33.3723 48.0034 28.7304 48 23.983C48 20.8321 47.3791 17.712 46.1728 14.8012C44.9664 11.8903 43.1983 9.24568 40.9695 7.01843C38.7407 4.79119 36.0948 3.02497 33.1831 1.82071C30.2714 0.616457 27.1509 -0.00223024 24 6.04075e-06ZM16.1021 34.4V29.7532L25.2936 24.2043L16.1021 18.8426V13.617L33.8723 24.2383L16.1021 34.4Z" fill="#323232"/>
                    </svg>
                </button>
            </div>
        </div>
    {% endif %}
</div>
