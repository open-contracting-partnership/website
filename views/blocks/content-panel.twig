{% set options = { 'id': null } | merge(block.options) %}

<div
    id="{{ options.id }}"
    class="block"
    data-block-type="content-panel"
    style="
        --background-colour: {{ block.background_colour }};
        --text-colour: {{ block.text_colour }};"
>
    <div class="block__background"></div>

    <div class="block__container acf-innerblocks-container" data-text-align="{{ block.text_align }}">
        <InnerBlocks
            template="{{ block.template }}"
            allowedBlocks="{{ block.allowed_blocks }}"
        />
    </div>
</div>
