{% if card.post_type == 'resource' %}
    {% set fallback_image = '/themes/' ~ theme.slug ~ '/resources/img/fallback-resource.jpg' %}
{% else %}
    {% set fallback_image = '/themes/' ~ theme.slug ~ '/resources/img/fallback-v2.jpg' %}
{% endif %}

<div
    class="card-arrow-link"
    {% for key, value in card.attributes %}
    {{ key }}="{{ value }}"
    {% endfor %}
>
    <div class="card-arrow-link__image">
        {% if card.image_url %}
            {{ imgix({
                src: card.image_url,
                params: {
                    fit: 'crop'
                },
                aspect_ratio: [21, 10],
                transforms: [{
                    w: 512
                }, {
                    w: 768
                }, {
                    w: 1024
                }, {
                    w: 1536
                }, {
                    w: 2048
                }],
                sizes: '(min-width: 1340px) 385px, (min-width: 768px) 32vw, 80vw'
            }) }}
        {% else %}
            {{ imgix({
                src: fallback_image,
                params: {
                    fit: 'crop'
                },
                aspect_ratio: [21, 10],
                transforms: [{
                    w: 512
                }, {
                    w: 768
                }, {
                    w: 1024
                }, {
                    w: 1536
                }, {
                    w: 2048
                }],
                sizes: '100vw'
            }) }}
        {% endif %}
    </div>

    <div class="card-arrow-link__main">
        <a class="card-arrow-link__title" href="{{ card.url }}">
            {{ card.title }}
        </a>

        {% if card.introduction %}
            <p class="card-arrow-link__introduction">{{ card.introduction }}</p>
        {% endif %}

        <svg class="card-arrow-link__arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 32 32">
            <circle cx="16" cy="16" r="16" fill="#fff"/>
            <path d="M16 0a16 16 0 1 0 16 15.989A15.987 15.987 0 0 0 16 0m-5.265 22.933v-3.097l6.127-3.7-6.127-3.574V9.078l11.847 7.08z" fill="#23b2a7"/>
        </svg>

    </div>
</div>
