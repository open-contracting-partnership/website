{% if not options %}
    {% set options = [] %}
{% endif %}

{% set options = { 'colour_scheme': null } | merge(options) %}

{# card.link may be a plain URL string (e.g. our-work-grid) or an ACF link array (card-half-image block) #}
{% set link_url = card.link.url is defined ? card.link.url : card.link %}
{% set link_target = card.link.target is defined ? card.link.target : '' %}

<div
    class="card card--half-image"
    style="
        --background-colour: {{ card.background_colour }};
        --hover-colour: {{ card.hover_colour }};
        --text-colour: {{ card.text_colour }};
    "
>
    <div class="card__body">
        <h3 class="card__heading">
            {% if link_url is not empty %}
                <a class="card__link" href="{{ link_url }}" target="{{ link_target }}">{{ card.title }}</a>
            {% else %}
                {{ card.title }}
            {% endif %}
        </h3>

        {% if card.strapline %}
            <p class="card__strapline">{{ card.strapline }}</p>
        {% endif %}
    </div>

    {% if card.image is not empty %}
        <div class="card__image">
            {{ imgix({
                src: card.image.src,
                transforms: [{
                    w: 128
                }, {
                    w: 256
                }, {
                    w: 512
                }],
                sizes: '36vw, (min-width: 1025px) 17vw, (min-width: 1350px) 234px',
            }) }}
        </div>
    {% endif %}
</div>
