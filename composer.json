{
    "require": {
        "php": "^8.1",
        "drewm/mailchimp-api": "^2.5",
        "imgix/imgix-php": "^4.1.0",
        "imliam/shareable-link": "^1.0.0",
        "ozdemirburak/iris": "^3.1",
        "rareloop/lumberjack-core": "^6.0",
        "vinkla/extended-acf": "13.8.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "php-stubs/acf-pro-stubs": "^6.5",
        "php-stubs/wordpress-stubs": "^6.8",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true,
        "policy": {
            "advisories": {
                "block": false
            }
        }
    }
}
